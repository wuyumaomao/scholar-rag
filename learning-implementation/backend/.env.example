# Copy this file to .env and fill in deployment-specific values.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_K=20
FETCH_K=20
TOP_K=5
MIN_SCORE=0.8
RRF_K=60
BM25_WEIGHT=1.25

MILVUS_ENABLED=true
MILVUS_URI=http://localhost:19531
MILVUS_COLLECTION_PREFIX=learning_rag

LLM_ENABLED=false
# HyDE 需要启用 LLM 并配置下面的地址与模型；默认检索不调用 LLM。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

VLM_ENABLED=false
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=
VLM_TIMEOUT_SECONDS=60
